# Copy to backend/.env. Every value below is optional: with no .env at all
# the service runs the deterministic local matcher on port 7241.

# local (default, no network) or openai
SUGGESTER_BACKEND=local

# Only read when SUGGESTER_BACKEND=openai. Never expose this to the browser:
# the key stays server-side and the frontend talks to this API instead.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

PORT=7241
DATABASE_URL=sqlite:///./data/app.db

# Upload guards
MAX_UPLOAD_BYTES=5242880
MAX_ROWS=50000

# Score below which a target column is reported as unmatched
MIN_CONFIDENCE=0.35
