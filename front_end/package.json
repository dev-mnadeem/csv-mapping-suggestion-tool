{
  "name": "csv-column-mapper-ui",
  "version": "1.0.0",
  "private": true,
  "description": "Upload a CSV, review the suggested column mapping, download the mapped file",
  "dependencies": {
    "@emotion/react": "^11.11.1",
    "@emotion/styled": "^11.11.0",
    "@mui/icons-material": "^5.14.14",
    "@mui/material": "^5.14.14",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-scripts": "5.0.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^5.17.0",
    "@testing-library/react": "^13.4.0",
    "@testing-library/user-event": "^14.5.2"
  },
  "scripts": {
    "start": "PORT=7242 react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "lint": "eslint src --max-warnings 0"
  },
  "eslintConfig": {
    "extends": [
      "react-app"
